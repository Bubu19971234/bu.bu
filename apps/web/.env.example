# --- Public (bundled into the browser) --------------------------------------
# Development Supabase project ONLY. Never point previews at production.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server-only (never prefix with NEXT_PUBLIC_) ----------------------------
SUPABASE_SERVICE_ROLE_KEY=
# Absolute base URL used in emailed links (guardian invitations).
APP_BASE_URL=http://localhost:3000
# AI provider for clip analysis. Phase 1: mock only.
AI_PROVIDER=mock
# Mailer. Phase 1: dev-log (prints links to server logs; not for production).
MAILER=dev-log
# Seconds a signed media URL stays valid.
MEDIA_SIGNED_URL_TTL_SECONDS=300
