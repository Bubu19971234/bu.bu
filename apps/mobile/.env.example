# Only EXPO_PUBLIC_* values are bundled into the app. NEVER put the service-role
# key or any other secret here — it would ship inside the binary.
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Web app base URL (server routes for uploads processing, guardian invites, AI).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
